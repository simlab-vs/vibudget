# PostgreSQL connection used by the backend
DATABASE_URL=postgresql://localhost/vibudget
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Apply pending migrations when the API starts
VIBUDGET_MIGRATE_ON_STARTUP=true
VIBUDGET_DEBUG=false

# Where the Astro frontend looks for the API
VIBUDGET_API_URL=http://127.0.0.1:8000
