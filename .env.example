# PostgreSQL connection used by the backend
DATABASE_URL=postgresql://localhost/vibudget
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Apply pending migrations when the API starts
VIBUDGET_MIGRATE_ON_STARTUP=true
VIBUDGET_DEBUG=false

# Where the Astro dev server proxies /api
VIBUDGET_API_URL=http://127.0.0.1:8000

# --- Docker Compose only -----------------------------------------------------
# Credentials for the bundled database. Compose builds DATABASE_URL for the
# backend container from these, so the value above is ignored there.
POSTGRES_USER=vibudget
POSTGRES_PASSWORD=vibudget
POSTGRES_DB=vibudget

# Host ports. WEB_PORT serves nginx in the default stack; DEV_WEB_PORT and
# DB_PORT are only published by the compose.dev.yaml overlay. The database sits
# off 5432 so the stack cannot clash with a PostgreSQL already on the host.
WEB_PORT=8080
BACKEND_PORT=8000
DEV_WEB_PORT=4321
DB_PORT=5433
