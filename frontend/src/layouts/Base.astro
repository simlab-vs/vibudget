---
import "@/styles/app.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const sections = [
  { href: "/", label: "Budget" },
  { href: "/accounts", label: "Accounts" },
  { href: "/transactions", label: "Transactions" },
  { href: "/payees", label: "Payees" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ViBudget</title>
  </head>
  <body>
    <header>
      <a href="/" class="wordmark">ViBudget</a>
      <nav>
        {
          sections.map((section) => (
            <a href={section.href} aria-current={Astro.url.pathname === section.href ? "page" : undefined}>
              {section.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <p class="banner" id="status" hidden></p>
      <slot />
    </main>
  </body>
</html>
